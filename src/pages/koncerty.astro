---
import Layout from "@components/Layout.astro";

const upcomingGigs = [];

const pastGigs = [
  {
    date: "2025-12-06",
    city: "Gdynia",
    venue: "Blues Club",
    logo: "/images/logo_blu.png"
  }
];

const events = [
  ...upcomingGigs.map((gig) => ({ ...gig, eventStatus: "https://schema.org/EventScheduled" })),
  ...pastGigs.map((gig) => ({ ...gig, eventStatus: "https://schema.org/EventCompleted" }))
];
---
<Layout title="Koncerty - TRolling Stones">
  <section class="container py-12">
    <h1 class="text-3xl font-bold">Koncerty</h1>
    <p class="mt-2 text-neutral-300">Nadchodzące daty występów.</p>

    <div class="mt-6 space-y-10">
      <div>
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-xl font-semibold">Nadchodzące koncerty</h2>
        </div>
        <div class="divide-y divide-neutral-800 border border-neutral-800 rounded-lg overflow-hidden">
          {upcomingGigs.length === 0 ? (
            <div class="p-6 text-neutral-400">Brak ogłoszonych koncertów.</div>
          ) : (
            upcomingGigs.map((g) => (
              <div class="p-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-start gap-4">
                  {g.logo && (
                    <img
                      src={g.logo}
                      alt={`Logo ${g.venue}`}
                      class="h-16 w-16 flex-shrink-0 rounded-lg border border-neutral-800 bg-white/5 object-contain p-2"
                      loading="lazy"
                    />
                  )}
                  <div>
                    <div class="font-semibold">{new Date(g.date).toLocaleDateString("pl-PL")}</div>
                    <div class="text-neutral-300">{g.city} - {g.venue}</div>
                  </div>
                </div>
                <div class="flex w-full justify-start sm:w-auto sm:justify-end">
                  {g.tickets ? (
                    <a class="px-3 py-1 rounded bg-brand-600 hover:bg-brand-500 text-white" href={g.tickets}>Kup bilety</a>
                  ) : (
                    <span class="text-neutral-400">Sprzedaż wkrótce</span>
                  )}
                </div>
              </div>
            ))
          )}
        </div>
      </div>

      <div>
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-xl font-semibold">Byłe koncerty</h2>
        </div>
        <div class="divide-y divide-neutral-800 border border-neutral-800 rounded-lg overflow-hidden">
          {pastGigs.length === 0 ? (
            <div class="p-6 text-neutral-400">Brak zagranych koncertów do wyświetlenia.</div>
          ) : (
            pastGigs.map((g) => (
              <div class="p-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-start gap-4">
                  {g.logo && (
                    <img
                      src={g.logo}
                      alt={`Logo ${g.venue}`}
                      class="h-16 w-16 flex-shrink-0 rounded-lg border border-neutral-800 bg-white/5 object-contain p-2"
                      loading="lazy"
                    />
                  )}
                  <div>
                    <div class="font-semibold">{new Date(g.date).toLocaleDateString("pl-PL")}</div>
                    <div class="text-neutral-300">{g.city} - {g.venue}</div>
                  </div>
                </div>
                <div class="flex w-full justify-start sm:w-auto sm:justify-end">
                  <span class="rounded border border-neutral-800 px-3 py-1 text-neutral-400">Zagrane wydarzenie</span>
                </div>
              </div>
            ))
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script type="application/ld+json">{JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': events.map(g => ({
    '@type': 'MusicEvent',
    name: `TRolling Stones - ${g.venue}`,
    startDate: g.date,
    eventStatus: g.eventStatus,
    location: {
      '@type': 'Place',
      name: g.venue,
      address: { '@type': 'PostalAddress', addressLocality: g.city, addressCountry: 'PL' }
    },
    performer: { '@type': 'MusicGroup', name: 'TRolling Stones' },
    url: (Astro.site?.origin ? `${Astro.site.origin}/koncerty` : '/koncerty'),
    offers: g.tickets ? { '@type': 'Offer', url: g.tickets, availability: 'https://schema.org/InStock' } : undefined
  }))
})}</script>
