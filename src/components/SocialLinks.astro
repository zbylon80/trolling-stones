---
import { socials } from "../data/site";
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<ul class:list={["social-links", { compact }]}>
  {socials.map((social) => (
    <li>
      <a href={social.url} target="_blank" rel="noopener noreferrer">
        <span class="social-mark" aria-hidden="true">{social.short}</span>
        <span>{social.name}</span>
        {!compact && <span class="social-arrow" aria-hidden="true">↗︎</span>}
      </a>
    </li>
  ))}
</ul>
<style>
  .social-links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .8rem; list-style: none; margin: 0; padding: 0; }
  .social-links a { display: flex; align-items: center; gap: .8rem; padding: 1.1rem; border: 1px solid #3d3027; border-radius: .5rem; color: #e4d7c8; background: #14110f; font-size: .8rem; text-decoration: none; transition: border-color .2s, background .2s; }
  .social-links a:hover { border-color: #9f5d47; background: #231812; color: #fff0df; }
  .social-mark { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid #8f604840; border-radius: 50%; color: #e99579; font-size: .6rem; font-weight: 800; flex-shrink: 0; }
  .social-arrow { margin-left: auto; color: #d68a6e; }
  .compact { display: flex; flex-wrap: wrap; gap: 1rem; }
  .compact a { border: 0; background: transparent; padding: .25rem 0; font-size: .7rem; }
  .compact .social-mark { display: none; }
  .social-links a:focus-visible { outline: 2px solid #f79883; outline-offset: 4px; }
  @media (max-width: 700px) { .social-links:not(.compact) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .social-links a { transition: none; } }
</style>
