---
const en = Astro.props.lang === "en" || Astro.url.pathname.startsWith("/en/");
---
<dialog id="lightbox-overlay" aria-label={en ? "Photo preview" : "Podgląd zdjęcia"}>
  <div class="lightbox-top"><p id="lightbox-caption"></p><button id="lightbox-close" type="button" autofocus aria-label={en ? "Close preview" : "Zamknij podgląd"}>×</button></div>
  <img id="lightbox-image" alt="" />
  <div class="lightbox-controls">
    <button id="lightbox-prev" type="button" aria-label={en ? "Previous photo" : "Poprzednie zdjęcie"}>‹</button>
    <span id="lightbox-counter" aria-live="polite"></span>
    <button id="lightbox-next" type="button" aria-label={en ? "Next photo" : "Następne zdjęcie"}>›</button>
  </div>
</dialog>
<style>
  dialog { width: min(1100px, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); padding: 1rem; margin: auto; border: 1px solid #69503c; border-radius: .65rem; background: #120e0b; color: #fff0df; }
  dialog::backdrop { background: #000d; backdrop-filter: blur(5px); }
  .lightbox-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .6rem; }
  .lightbox-top p { margin: 0; color: #c8b6a2; font-size: .8rem; }
  button { width: 44px; height: 44px; flex-shrink: 0; border: 1px solid #624431; border-radius: .3rem; background: #24180f; color: #fff0df; font-size: 1.6rem; }
  button:hover { background: #493022; }
  #lightbox-image { width: 100%; height: min(70dvh, 800px); object-fit: contain; }
  .lightbox-controls { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: .75rem; }
  #lightbox-counter { color: #a98c71; font-size: .7rem; }
</style>
<script>
  const modal = document.querySelector<HTMLDialogElement>("#lightbox-overlay");
  const image = document.querySelector<HTMLImageElement>("#lightbox-image");
  const caption = document.querySelector("#lightbox-caption");
  const counter = document.querySelector("#lightbox-counter");
  const previous = document.querySelector<HTMLButtonElement>("#lightbox-prev");
  const next = document.querySelector<HTMLButtonElement>("#lightbox-next");
  let photos: HTMLElement[] = [];
  let index = 0;
  function renderPhoto() {
    const trigger = photos[index];
    if (!trigger || !image) return;
    image.src = trigger.dataset.full || trigger.getAttribute("href") || trigger.getAttribute("src") || "";
    image.alt = trigger.dataset.alt || trigger.getAttribute("alt") || "";
    if (caption) caption.textContent = image.alt;
    if (counter) counter.textContent = `${index + 1} / ${photos.length}`;
    previous?.classList.toggle("hidden", photos.length < 2);
    next?.classList.toggle("hidden", photos.length < 2);
  }
  function step(amount: number) { if (photos.length) { index = (index + amount + photos.length) % photos.length; renderPhoto(); } }
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const trigger = event.target.closest<HTMLElement>("[data-lightbox]");
    if (!trigger || !modal) return;
    event.preventDefault();
    const group = trigger.dataset.lightboxGroup;
    photos = [...document.querySelectorAll<HTMLElement>("[data-lightbox]")].filter(item => item.dataset.lightboxGroup === group && !item.closest("[hidden]"));
    index = photos.indexOf(trigger);
    renderPhoto();
    modal.showModal();
  });
  document.querySelector("#lightbox-close")?.addEventListener("click", () => modal?.close());
  previous?.addEventListener("click", () => step(-1));
  next?.addEventListener("click", () => step(1));
  modal?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") { event.preventDefault(); step(-1); }
    if (event.key === "ArrowRight") { event.preventDefault(); step(1); }
  });
  modal?.addEventListener("click", (event) => {
    const bounds = modal.getBoundingClientRect();
    if (event.target === modal && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) modal.close();
  });
  modal?.addEventListener("close", () => { image?.removeAttribute("src"); photos = []; });
</script>
